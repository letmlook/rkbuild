# /etc/update-motd.d/99-rkbuild —— 登录欢迎信息
# 由 Ubuntu 的 update-motd 机制在登录时执行。
# 占位符 __VENDOR__ / __VARIANT__ / __BOARD__ / __RKBUILD_RELEASE__ 在构建时替换。

cat <<EOF

============================================================
  rkbuild Ubuntu 22.04 (jammy) for RK3588
============================================================
  Vendor  : __VENDOR__
  Variant : __VARIANT__
  Board   : __BOARD__
  Release : __RKBUILD_RELEASE__

  常用命令：
    rkbuild-info          系统 / Docker / RKNN 信息
    docker info           Docker 状态
    ip -br a              网络接口
    systemctl status docker

  默认账号：见 /etc/rkbuild-release 与仓库 docs/ubuntu.md
  首次登录后请立即修改密码（passwd）。
============================================================

EOF
