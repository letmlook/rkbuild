#!/bin/sh
# /usr/local/bin/rkbuild-doctor —— 运行环境健康检查
#
# 检查项：
#   1. 内核 namespaces / cgroups / overlay / bridge
#   2. Docker daemon
#   3. RKNPU device
#   4. 关键库存在
#   5. 磁盘空间 / 网络

PASS=0
FAIL=0
WARN=0

check_pass() { printf '  [ OK ]  %s\n' "$*"; PASS=$((PASS+1)); }
check_fail() { printf '  [FAIL]  %s\n' "$*"; FAIL=$((FAIL+1)); }
check_warn() { printf '  [WARN]  %s\n' "$*"; WARN=$((WARN+1)); }

section() { printf '\n── %s ──\n' "$*"; }

# 1. 内核
section "Kernel features"
for sym in NAMESPACES OVERLAY_FS BRIDGE NF_TABLES CGROUP_SCHED; do
    if zgrep -q "CONFIG_${sym}=y" /proc/config.gz 2>/dev/null; then
        check_pass "CONFIG_${sym}=y"
    else
        check_fail "CONFIG_${sym} not set in kernel"
    fi
done

# /sys/fs/cgroup
if mount | grep -q 'cgroup2.*sys/fs/cgroup'; then
    check_pass "cgroup2 mounted at /sys/fs/cgroup"
else
    check_warn "cgroup2 not mounted; docker may still work"
fi

# 2. Docker
section "Docker"
if command -v docker >/dev/null 2>&1; then
    check_pass "docker cli present"
    if [ -S /var/run/docker.sock ]; then
        check_pass "docker socket exists"
        if docker info >/dev/null 2>&1; then
            storage=$(docker info 2>/dev/null | awk '/^Storage Driver:/ {print $3}')
            check_pass "docker daemon responds (storage=$storage)"
        else
            check_fail "docker daemon not responding"
        fi
    else
        check_warn "docker daemon socket not found; try /etc/init.d/S95dockerd start"
    fi
else
    check_fail "docker cli not installed"
fi

# 3. RKNPU
section "NPU / GPU"
if ls /dev/dri/rknpu 2>/dev/null >/dev/null; then
    check_pass "/dev/dri/rknpu exists"
else
    check_warn "/dev/dri/rknpu not present (load rknpu kernel module)"
fi
if ls /dev/dri/card0 /dev/dri/renderD128 2>/dev/null >/dev/null; then
    check_pass "DRI devices present (mali/GPU)"
else
    check_warn "No DRI devices (mali/GPU not enabled; headless variant?)"
fi

# 4. 关键库
section "Key libraries"
for lib in libopenssl libmbedtls libcurl libsqlite3 libwebsockets; do
    if ldconfig -p 2>/dev/null | grep -q "${lib}\.so"; then
        check_pass "${lib}.so present"
    else
        check_warn "${lib}.so missing"
    fi
done

# 5. 磁盘
section "Storage"
df -h /var/lib/docker 2>/dev/null | tail -1 | while read line; do
    avail=$(echo "$line" | awk '{print $4}')
    echo "  /var/lib/docker free: $avail"
done

# 总结
section "Summary"
echo "  PASS=$PASS  WARN=$WARN  FAIL=$FAIL"
if [ "$FAIL" -gt 0 ]; then
    echo "  → 有 ${FAIL} 项需要关注。"
    exit 1
fi
exit 0