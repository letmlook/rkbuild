# overlay/fragments/rkbuild_toolchain.config
#
# 覆盖 radxa/buildroot @ rockchip/2024.02 默认 arm_10_aarch64.config 的 toolchain 设置。
# radxa 默认用 Bootlin gcc-arm-10.3-2021.07（130 MB，下载慢，且 Bootlin 直连经常不通）。
# 我们改用 FriendlyARM prebuilts 11.3-aarch64（44 MB，走 GitHub 镜像即可）。
#
# 解压后路径：dist/src/prebuilts/gcc/linux-x86/aarch64/11.3-aarch64/
# 预期内部布局：
#   bin/aarch64-none-linux-gnu-gcc
#   lib/gcc/aarch64-none-linux-gnu/11.3.0/
#   aarch64-none-linux-gnu/libc/usr/   (sysroot)

# 关闭 radxa 默认的 GCC 10
# BR2_TOOLCHAIN_EXTERNAL_GCC_10 is not set
BR2_TOOLCHAIN_EXTERNAL_GCC_11=y

# 路径
BR2_TOOLCHAIN_EXTERNAL_PATH="$(TOPDIR)/../prebuilts/gcc/linux-x86/aarch64/FriendlyARM/toolchain/11.3-aarch64/"
# FriendlyARM 11.3 实际用 aarch64-cortexa53-linux-gnu 前缀（不是 upstream 的 aarch64-none-linux-gnu）
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-cortexa53-linux-gnu"

# 11.3 工具链对应的内核头（5.10+）
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
# BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_20 is not set

# glibc（FriendlyARM 11.3 用 glibc 2.35）
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_PACKAGE_GLIBC_UTILS=y

# C++/Fortran/OpenMP/inetrpc（与 arm_10 一致）
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TOOLCHAIN_EXTRA_LIBS="libgomp.so"