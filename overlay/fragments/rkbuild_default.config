# overlay/fragments/rkbuild_default.config
#
# 两变体共有的默认软件：系统、网络、外设、多媒体、工具、库。
# GUI 专属包在 rkbuild_gui.config 中。

# ---------- 系统基础 ----------
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_CHRONY=y
BR2_PACKAGE_HAVEGED=y
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_LOGROTATE=y
BR2_PACKAGE_SYSLOG_NG=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_E2FSCK=y
BR2_PACKAGE_BTRFS_PROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_AGETTY=y
BR2_PACKAGE_UTIL_LINUX_AGETTY_LOGIN_ISSUE=y

# ---------- 网络 ----------
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_BRIDGE_UTILS=y
BR2_PACKAGE_VLAN=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_NCAT=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_PPPD=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_C_ARES=y

# ---------- 外设/硬件调试 ----------
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPIDEV_TEST=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_LIBMODBUS=y

# ---------- 多媒体（headless 仍保留转码能力） ----------
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GSTREAMER1_GST_DEBUG=y
BR2_PACKAGE_GSTREAMER1_PLUGINS_BASE=y
BR2_PACKAGE_GSTREAMER1_PLUGINS_GOOD=y
BR2_PACKAGE_GSTREAMER1_PLUGINS_BAD=y
BR2_PACKAGE_GSTREAMER1_PLUGINS_UGLY=y
BR2_PACKAGE_GSTREAMER1_PLUGINS_LIBAV=y
BR2_PACKAGE_GSTREAMER1_PLUGIN_X264=y
BR2_PACKAGE_GSTREAMER1_PLUGINS_V4L2=y
BR2_PACKAGE_GSTREAMER1_ROCKCHIP=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_ROCKCHIP_MPP=y
BR2_PACKAGE_ROCKCHIP_MPP_ALLOCATOR_DRM=y
BR2_PACKAGE_LIBV4L_RKMPP=y
BR2_PACKAGE_ROCKCHIP_RGA=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_TINYALSA=y

# ---------- AI / 推理 ----------
BR2_PACKAGE_RKNPU2=y
BR2_PACKAGE_RKNPU2_ARCH=aarch64
BR2_PACKAGE_RKNPU_FW=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_OPENCV3=y
BR2_PACKAGE_OPENCV3_PYTHON=y

# 自有 local package
BR2_PACKAGE_RKBUILD_HELPER=y
BR2_PACKAGE_ONNXRUNTIME_RKNN=y
BR2_PACKAGE_TFLITE_DELEGATE_RKNPU2=y

# ---------- 工具 ----------
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_LM_SENSORS=y
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_BASH_COMPLETION=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LSOF=y

# ---------- 常用库 ----------
# TLS / 加密
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_MBEDTLS=y

# 数据格式
BR2_PACKAGE_CJSON=y
BR2_PACKAGE_JANSSON=y
BR2_PACKAGE_MSGPACK=y
BR2_PACKAGE_LIBCONFUSE=y

# 网络客户端
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBMOSQUITTO=y
BR2_PACKAGE_LIBWEBSOCKETS=y

# 数据库
BR2_PACKAGE_SQLITE=y

# RPC / 数据
BR2_PACKAGE_PROTOBUF_C=y
BR2_PACKAGE_FLATBUFFERS=y

# 多媒体辅助
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_LIBJPEG_TURBO=y
BR2_PACKAGE_LIBWEBP=y
BR2_PACKAGE_FREETYPE=y

# 压缩
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_SNAPPY=y
# lz4 由 buildroot 默认开启（BR2_PACKAGE_LZ4）

# 嵌入式 Web 服务器
BR2_PACKAGE_MONGOOSE=y
# BR2_PACKAGE_CIVETWEB=y      # 备选

# 事件循环
BR2_PACKAGE_LIBUV=y

# 杂项
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y