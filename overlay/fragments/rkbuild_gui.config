# overlay/fragments/rkbuild_gui.config
#
# 仅 GUI 变体使用的软件：Qt6、wayland/weston、mali、tslib、SDL2 等。
# Headless 变体的 defconfig 不包含本文件。

# ---------- Qt6 ----------
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_SQL=y
BR2_PACKAGE_QT6BASE_PRINTSUPPORT=y
BR2_PACKAGE_QT6BASE_DBUS=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_FREETYPE=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y

# Qt6 modules
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6QUICKCONTROLS2=y
BR2_PACKAGE_QT6MULTIMEDIA=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6WEBSOCKETS=y
BR2_PACKAGE_QT6SERIALPORT=y
BR2_PACKAGE_QT6SHADERTOOLS=y
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_QT6IMAGEFORMATS=y
BR2_PACKAGE_QT6SCXML=y

# ---------- GUI 支撑栈 ----------
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_UTILS=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DRM=y
BR2_PACKAGE_WESTON_DEMO_CLIENTS=y
BR2_PACKAGE_WESTON_SIMPLE_CLIENTS=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_DRI_DRIVER_I915=y
BR2_PACKAGE_MESA3D_DRI_DRIVER_ROCKCHIP=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LIMA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_KMSRO=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER=y
BR2_PACKAGE_ROCKCHIP_MALI=y

# ---------- 输入 ----------
BR2_PACKAGE_TSLIB=y
BR2_PACKAGE_TSLIB_TOOLS=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBINPUT_TOOLS=y

# ---------- 应用辅助 ----------
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_OPENGL=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_NET=y

# Qt 字体支持（GUI 必）
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_HARFBUZZ=y