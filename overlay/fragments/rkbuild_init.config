# overlay/fragments/rkbuild_init.config
#
# init system 选择（busybox init 默认；systemd 可选）
# 通过 defconfig 中条件 include 或 defconfig 文件名后缀选择。
# 默认 busybox init。

# ----- busybox init -----
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_INDIVIDUAL_BINARIES=y
BR2_PACKAGE_BUSYBOX_WATCHDOG=y
BR2_PACKAGE_EUDEV=y

# ----- systemd（注释保留；启用请在 defconfig 中加 BR2_INIT_SYSTEMD=y） -----
# BR2_INIT_SYSTEMD=y
# BR2_PACKAGE_SYSTEMD=y
# BR2_PACKAGE_SYSTEMD_JOURNALD=y
# BR2_PACKAGE_SYSTEMD_LOGIND=y
# BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
# BR2_PACKAGE_SYSTEMD_NETWORKD=y
# BR2_PACKAGE_SYSTEMD_RESOLVED=y
# BR2_PACKAGE_SYSTEMD_BOOT=y