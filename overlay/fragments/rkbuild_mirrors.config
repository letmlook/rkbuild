# overlay/fragments/rkbuild_mirrors.config
#
# 国内镜像（清华 + 中科大 + 阿里云）替换默认 sources.buildroot.net，
# 加速 dl 阶段。如国外访问良好可保留默认。
#
# 用法：在 defconfig 中 #include 引入。

# Buildroot 主包源
BR2_PRIMARY_SITE="https://mirrors.tuna.tsinghua.edu.cn/buildroot"
# BR2_BACKUP_SITE=""        # 留空：失败不自动降级，避免静默下载到别的源

# GNU mirror
BR2_GNU_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/gnu"

# 注：以下 Kconfig 选项仅在 Buildroot 2024.02+ 中可用
BR2_KERNEL_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/kernel.org"
BR2_CPAN_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/CPAN"
BR2_PYPI_MIRROR="https://pypi.tuna.tsinghua.edu.cn/simple"

# GitHub 代理（如果团队网络受限，可在调用 fetch 时手动设 GIT_CONFIG_GLOBAL）
# git config --global url."https://ghproxy.com/https://github.com/".insteadOf "https://github.com/"